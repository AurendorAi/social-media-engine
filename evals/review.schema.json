{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent rendered pair review (not model self-grading)",
  "type": "object",
  "required": ["pair_id", "reviewer", "render_environment", "winner", "confidence", "outputs", "reason"],
  "properties": {
    "pair_id": {"type": "string"},
    "reviewer": {"type": "string", "minLength": 1},
    "render_environment": {"type": "string", "minLength": 1},
    "winner": {"enum": ["A", "B", "tie", "neither", "visual_review_missing"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "reason": {"type": "string", "minLength": 1},
    "outputs": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["label", "visually_reviewed", "screenshot_sha256", "scores", "hard_failures", "observations", "publishable_after_owner_approval"],
        "properties": {
          "label": {"type": "string"},
          "visually_reviewed": {"type": "boolean"},
          "screenshot_sha256": {"type": ["string", "null"]},
          "scores": {
            "type": ["object", "null"],
            "required": ["brand_fidelity", "audience_payoff", "distinctive_concept", "copy_quality", "visual_craft", "format_utility"],
            "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 4}
          },
          "hard_failures": {"type": "array", "items": {"type": "string"}},
          "observations": {"type": "array", "items": {"type": "string"}},
          "publishable_after_owner_approval": {"type": "boolean"}
        }
      }
    }
  }
}
